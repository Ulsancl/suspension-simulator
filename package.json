{
  "name": "suspension-lab",
  "version": "1.4.1",
  "private": true,
  "type": "module",
  "description": "단일 휠 서스펜션의 수직 응답을 비교하는 3D 실험 프로그램",
  "main": "desktop/main.cjs",
  "author": "Suspension Lab",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/build-web.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/physics.test.mjs tests/road-sequence.test.mjs tests/component-curves.test.mjs tests/experiments.test.mjs tests/engineering.test.mjs tests/experiment-batch.test.mjs tests/consumer-guide.test.mjs tests/playback-clock.test.mjs tests/detail-model.test.mjs tests/scene-detail.test.mjs tests/window-state.test.mjs tests/safe-files.test.mjs tests/security-inputs.test.mjs tests/service-worker.test.mjs tests/launcher.test.mjs",
    "test:guide": "node tests/consumer-guide-browser.test.mjs",
    "test:storage": "node tests/experiment-migration-browser.test.mjs",
    "test:browser": "node tests/browser.test.mjs",
    "test:detail": "node tests/detail-browser.test.mjs",
    "test:design": "node tests/design.test.mjs",
    "test:product": "node tests/product.test.mjs",
    "package:release": "node scripts/package-release.mjs",
    "serve:release": "node scripts/serve-release.mjs",
    "test:offline": "node tests/offline-release.test.mjs",
    "test:dashboard": "node tests/dashboard.test.mjs",
    "desktop": "node scripts/desktop.mjs start",
    "package:desktop": "node scripts/desktop.mjs package",
    "package:desktop:test": "node scripts/desktop.mjs package-test",
    "package:desktop:signed": "node scripts/desktop.mjs package-signed",
    "test:desktop": "node tests/desktop.test.mjs"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@electron/fuses": "1.8.0",
    "electron": "44.11.6",
    "electron-builder": "26.15.3",
    "playwright": "^1.55.1",
    "vite": "^7.3.8"
  },
  "overrides": {
    "minimatch@>=7 <11.0.1": "^11.0.8"
  }
}
